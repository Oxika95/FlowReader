" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][1080,2400]" drawing-order="0" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.personal.flowreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="true" long-clickable="false" password="false" selected="false" bounds="[0,0][1080,2400]" drawing-order="0" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.personal.flowreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,0][1034,184]" drawing-order="0" hint=""><node index="0" text="But to return to dearer considerations. Shall I meet you again, after having traversed immense seas, and returned by the most southern cape of Africa or America? I dare not expect such success, yet I cannot bear to look on the reverse of the picture. Continue for the present to write to me by every opportunity: I may receive your letters on some occasions when I need them most to support my spirits. I love you very tenderly. Remember me with affection, should you never hear from me again." resource-id="" class="android.widget.TextView" package="com.personal.flowreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[46,0][1034,137]" drawing-order="0" hint="" /></node><node index="1" text="" resource-id="" class="android.view.View" package="com.personal.flowreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,184][1034,336]" drawing-order="0" hint=""><node index="0" text="Your affectionate brother, Robert Walton" resource-id="" class="android.widget.TextView" package="com.personal.flowreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[46,219][1034,289]" drawing-order="0" hint="" /></node><node index="2" text="" resource-id="" class="android.view.View" package="com.personal.flowreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,336][1034,511]" drawing-order="0" hint=""><node index="0" text="Letter 3" resource-id="" class="android.widget.TextView" package="com.personal.flowreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[46,371][1034,464]" drawing-order="0" hint="" /></node><node index="3" text="" resource-id="" class="android.view.View" package="com.personal.flowreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,511][1034,663]" drawing-order="0" hint=""><node index="0" text="To Mrs. Saville, England." resource-id="" class="android.widget.TextView" package="com.personal.flowreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[46,546][1034,616]" drawing-order="0" hint="" /></node><node index="4" text="" resource-id="" class="android.view.View" package="com.personal.flowreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,663][1034,815]" drawing-order="0" hint="" /><node index="5" text="" resource-id="" class="android.view.View" package="com.personal.flowreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,815][1034,967]" drawing-order="0" hint=""><node index="0" text="My dear Sister," resource-id="" class="android.widget.TextView" package="com.personal.flowreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[46,850][1034,920]" drawing-order="0" hint="" /></node><node index="6" text="" resource-id="" class="android.view.View" package="com.personal.flowreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,967][1034,2309]" drawing-order="0" hint=""><node index="0" text="I write a few lines in haste to say that I am safe—and well advanced on my voyage. This letter will reach England by a merchantman now on its homeward voyage from Archangel; more fortunate than I, who may not see my native land, perhaps, for many years. I am, however, in good spirits: my men are bold and apparently firm of purpose, nor do the floating sheets of ice that continually pass us, indicating the dangers of the region towards which we are advancing, appear to dismay them. We have already reached a very high latitude; but it is the height of summer, and although not so warm as in England, the southern gales, which blow us speedily towards those shores which I so ardently desire to attain, breathe a degree of renovating warmth which I had not expected." resource-id="" class="android.widget.TextView" package="com.personal.flowreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[46,1002][1034,2262]" drawing-order="0" hint="" /></node><node index="7" text="" resource-id="" class="android.view.View" package="com.personal.flowreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,2309][1034,2400]" drawing-order="0" hint=""><node index="0" text="No incidents have hitherto befallen us that would make a figure in a letter. One or two stiff gales and the springing of a leak are accidents which experienced navigators scarcely remember to record, and I shall be well content if nothing worse happen to us during our voyage." resource-id="" class="android.widget.TextView" package="com.personal.flowreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[46,2344][1034,2400]" drawing-order="0" hint="" /></node></node><node index="1" text="" resource-id="" class="android.view.View" package="com.personal.flowreader" content-desc="Home position bar" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,687][1080,779]" drawing-order="0" hint="" /><node index="2" text="" resource-id="" class="android.widget.ImageView" package="com.personal.flowreader" content-desc="Open synth log" checkable="false" checked="