</node><node index="2" text="" resource-id="" class="android.view.View" package="com.personal.flowreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,256][1034,408]" drawing-order="0" hint=""><node index="0" text="To Mrs. Saville, England." resource-id="" class="android.widget.TextView" package="com.personal.flowreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[46,291][1034,361]" drawing-order="0" hint="" /></node><node index="3" text="" resource-id="" class="android.view.View" package="com.personal.flowreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,408][1034,560]" drawing-order="0" hint=""><node index="0" text="July 7th, 17—." resource-id="" class="android.widget.TextView" package="com.personal.flowreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[46,443][1034,513]" drawing-order="0" hint="" /></node><node index="4" text="" resource-id="" class="android.view.View" package="com.personal.flowreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,560][1034,687]" drawing-order="0" hint=""><node index="0" text="My dear Sister," resource-id="" class="android.widget.TextView" package="com.personal.flowreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[46,595][1034,665]" drawing-order="0" hint="" /></node><node index="5" text="" resource-id="" class="android.view.View" package="com.personal.flowreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,779][1034,2054]" drawing-order="0" hint=""><node index="0" text="I write a few lines in haste to say that I am safe—and well advanced on my voyage. This letter will reach England by a merchantman now on its homeward voyage from Archangel; more fortunate than I, who may not see my native land, perhaps, for many years. I am, however, in good spirits: my men are bold and apparently firm of purpose, nor do the floating sheets of ice that continually pass us, indicating the dangers of the region towards which we are advancing, appear to dismay them. We have already reached a very high latitude; but it is the height of summer, and although not so warm as in England, the southern gales, which blow us speedily towards those shores which I so ardently desire to attain, breathe a degree of renovating warmth which I had not expected." resource-id="" class="android.widget.TextView" package="com.personal.flowreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[46,779][1034,2007]" drawing-order="0" hint="" /></node><node index="6" text="" resource-id="" class="android.view.View" package="com.personal.flowreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,2054][1034,2400]" drawing-order="0" hint=""><node index="0" text="No incidents have hitherto befallen us that would make a figure in a letter. One or two stiff gales and the springing of a leak are accidents which experienced navigators scarcely remember to record, and I shall be well content if nothing worse happen to us during our voyage." resource-id="" class="android.widget.TextView" package="com.personal.flowreader" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[46,2089][1034,2400]" drawing-order="0" hint="" /></node></node><node index="1" text="" resource-id="" class="android.view.View" package="com.personal.flowreader" content-desc="Home position bar" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,687][1080,779]" drawing-order="0" hint="" /></node></node></node></node></node></node></hierarchy>